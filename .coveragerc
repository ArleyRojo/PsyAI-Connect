[run]
source = apps
omit =
    */tests/*
    */migrations/*
    */manage.py
    */settings/*
    */wsgi.py
    */asgi.py

[report]
show_missing = true
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__
    raise NotImplementedError
    pass
    except ImportError

[html]
directory = htmlcov
