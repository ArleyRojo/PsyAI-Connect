# Django
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL)
DB_NAME=psyai_connect
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PsyAI Connect <noreply@psyaiconnect.com>

# CORS / CSRF
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://psyai-connect.com

# Wompi
WOMPI_ENV=test
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=xxx
WOMPI_EVENTS_SECRET=xxx

# Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low

# Site
SITE_URL=http://localhost:8000

# Upload
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,webp,doc,docx
MAX_UPLOAD_SIZE_MB=5

# Rate limits
REGISTER_RATE_LIMIT=20 per minute
LOGIN_RATE_LIMIT=60 per minute
PASSWORD_RECOVERY_RATE_LIMIT=10 per minute

# WhatsApp (Twilio)
WHATSAPP_ENABLED=False
TWILIO_SID=your_account_sid
TWILIO_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886