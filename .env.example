# =============================================
# PsyAI Connect - Variables de entorno
# =============================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como ".env"
# 2. Completa los valores según tu entorno local
# 3. NUNCA subas el archivo ".env" a Git

# Clave secreta para firmar sesiones de Flask
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura

# Puerto del servidor (opcional, por defecto 5000)
PORT=5000

# Rate limits de autenticacion
# En development los defaults son mas amplios; en production son mas estrictos.
LOGIN_RATE_LIMIT=60 per minute
REGISTER_RATE_LIMIT=20 per minute
PASSWORD_RECOVERY_RATE_LIMIT=10 per minute

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3.1-flash-lite

# Nivel de pensamiento del modelo Gemini (minimal, low, medium, high)
# Valores mas bajos (low) reducen latencia; mas altos (medium/high) mejoran matiz
# Se puede sobreescribir por paciente desde el panel de admin (ChatbotConfig.thinking_level)
GEMINI_THINKING_LEVEL=low
# Brevo (email transaccional) — https://www.brevo.com
BREVO_API_KEY=poner_api_key_aqui
BREVO_FROM=tu_correo_verificado_en_brevo@gmail.com
BREVO_FROM_NAME=PsyAI Connect

# Wompi (pasarela de pagos PSE/tarjeta) — https://comercios.wompi.co
# 1. Crea una cuenta de comercio en Wompi y activa el modo "Sandbox" en tu dashboard
# 2. Copia las 4 llaves desde Dashboard > Desarrolladores
# 3. WOMPI_ENV=test mientras pruebas, cambialo a WOMPI_ENV=prod solo cuando salgas a producción
WOMPI_ENV=test
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
