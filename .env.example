# ═══════════════════════════════════════════════════════════════
# PsyAI Connect - Environment Variables Example
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database (MySQL) ──────────────────────────────────────────────
DB_NAME=psyai_connect
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# ── CORS & CSRF ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,https://yourdomain.com

# ── Email (SMTP) ──────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=PsyAI Connect <noreply@yourdomain.com>

# ── Site URL ──────────────────────────────────────────────────────
SITE_URL=http://localhost:8000

# ── Manual Payment External Link ──────────────────────────────────
PAGO_CUENTA_URL=
PAGO_CUENTA_NOMBRE=

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gemini AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low

# ── Rate Limits ───────────────────────────────────────────────────
REGISTER_RATE_LIMIT=20 per minute
LOGIN_RATE_LIMIT=60 per minute
PASSWORD_RECOVERY_RATE_LIMIT=10 per minute

# ── File Upload ───────────────────────────────────────────────────
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf,gif,webp,doc,docx
MAX_UPLOAD_SIZE_MB=5

# ── WhatsApp / Twilio ─────────────────────────────────────────────
WHATSAPP_ENABLED=False
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_TPL_RECORDATORIO=
TWILIO_TPL_CONFIRMACION=
TWILIO_TPL_CANCELACION=
TWILIO_TPL_MENSAJE_PRO=

# ── Development Flags ─────────────────────────────────────────────
ALLOW_PAGE_PREVIEW_WITHOUT_SESSION=False