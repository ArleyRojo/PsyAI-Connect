# =============================================
# PsyAI Connect - Variables de entorno
# =============================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como ".env"
# 2. Completa los valores según tu entorno local
# 3. NUNCA subas el archivo ".env" a Git

# ── Django ───────────────────────────────────────────────────────────────────
# Clave secreta para firmar sesiones de Django
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura

# Puerto del servidor (opcional, por defecto 8000)
PORT=8000

# ── Base de datos ─────────────────────────────────────────────────────────────
# Local (`runserver`): SQLite en archivo por defecto, no necesitas MySQL.
# Para usar MySQL local: USE_MYSQL=1 + DB_HOST=localhost (con MySQL corriendo).
# En Docker Compose se usa MySQL (DB_HOST=db lo inyecta el compose).
USE_MYSQL=
DB_NAME=psyai_connect
DB_USER=psyai
DB_PASSWORD=psyai_pass
DB_HOST=db
DB_PORT=3306

# Root password para el contenedor MySQL (solo interno de Docker)
DB_ROOT_PASSWORD=rootpass

# ── Rate limits ──────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=60 per minute
REGISTER_RATE_LIMIT=20 per minute
PASSWORD_RECOVERY_RATE_LIMIT=10 per minute

# ── Gemini (Chatbot IA) ─────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
# GEMINI_API_KEY=tu-api-key-aqui
# GEMINI_API_KEYS=clave1,clave2,clave3  # opcional: rotación de claves
# Modelo de respaldo (Gemma, mismo endpoint de Gemini API). Solo se usa cuando
# TODAS las keys del modelo principal agotaron cuota (429). Cascada: Gemini -> Gemma -> fallback local.
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it

# ── Email (SMTP) ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=tu-correo@gmail.com

# ── Wompi (Pasarela de pago) ────────────────────────────────────────────────
# WOMPI_PUBLIC_KEY=
# WOMPI_INTEGRITY_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Obtén credenciales en: https://console.cloud.google.com/apis/credentials
# Crea un OAuth 2.0 Client ID de tipo "Web application"
# Autoriza los dominios de redirect: accounts/social/login/callback
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret


